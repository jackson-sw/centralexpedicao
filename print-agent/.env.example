# URL do backend do Central Expedição (a mesma que o app usa, com https://)
API_URL=https://seu-dominio.com.br

# Precisa ser IDÊNTICA ao AGENT_API_KEY configurado no backend/.env do servidor.
AGENT_API_KEY=TROQUE_POR_UMA_CHAVE_LONGA_E_ALEATORIA

# De quanto em quanto tempo (em milissegundos) o agente consulta a fila.
# 5000 = a cada 5 segundos. Não precisa ser muito rápido.
POLL_INTERVAL_MS=5000

# Impressoras ligadas a ESTE computador, separadas por vírgula (nome
# idêntico ao do Windows e ao IMPRESSORA_*_NOME do servidor). Use quando
# houver um agente em cada computador (ex.: um no Almoxarifado, outro na
# Expedição), para cada um só imprimir os jobs das suas impressoras.
# Vazio = imprime tudo (um único computador-ponte com todas as impressoras).
# Exemplos:
#   Computador do Almoxarifado: IMPRESSORAS_LOCAIS=Argox-Almoxarifado
#   Computador da Expedição:    IMPRESSORAS_LOCAIS=Argox-expedicao
IMPRESSORAS_LOCAIS=
