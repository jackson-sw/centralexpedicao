# ── Variáveis usadas pelo docker-compose.yml (não pelo backend diretamente) ──
# Copie para ".env" na raiz do projeto antes de rodar `docker compose up`.
# Para rodar o backend SEM Docker, use backend/.env.example.

# Senha do usuário root do MySQL (apenas dentro do container do banco)
DB_ROOT_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# Nome do banco — deve ser igual ao criado em banco_de_dados.sql
# (burntech_expedicao), a menos que você edite o DDL também.
DB_NAME=burntech_expedicao

# Usuário/senha que o backend usará para conectar ao MySQL
DB_USER=burntech_expedicao_app
DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# JWT
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
JWT_EXPIRES_IN=8h

# Domínio do frontend em produção (ou * em homologação)
CORS_ORIGIN=https://seu-dominio.com.br

# Porta exposta no host pela aplicação (mapeada para 3002 no container)
PORT=3002

# ── Perfis de acesso (hash bcrypt — ver backend/.env.example para gerar) ──
EXPEDICAO_PASSWORD_HASH=$2b$12$QcMyhtXS1r7DD.UaNqe4BeOx9Q/nFAiEztZn7Rn3HEapqhetNcrky
EM_CAMPO_PASSWORD_HASH=$2b$12$hwdD4OEyipS2aigiqJA0QObK.SBv05mLN6qrE3X54fWQISBehL9qa
ALMOXARIFADO_PASSWORD_HASH=$2b$12$h4614nkrY33HO8lB92LalOQfEDCvf5/zq1AjYGNsjtW4A/R/5LSAe
ADMIN_PASSWORD_HASH=$2b$12$YoPZovSRJ1urdEq.7ToJDumhZ3.S7kwxnrxKirup.u6EFbrFAcQa.

# ── E-mail SMTP (já deixado pronto para uso futuro) ──────────
MAIL_SERVER=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=SEU_EMAIL@burntech.com.br
MAIL_PASSWORD=SUA_SENHA_AQUI
MAIL_DEFAULT_SENDER=SEU_EMAIL@burntech.com.br
