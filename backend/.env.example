# ── E-mail SMTP ──────────────────────────────────
# Usado para enviar o romaneio (PDF) ao finalizar uma caixa.
MAIL_SERVER=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=SEU_EMAIL@burntech.com.br
MAIL_PASSWORD=SUA_SENHA_AQUI
MAIL_DEFAULT_SENDER=SEU_EMAIL@burntech.com.br

# Destinatário(s) do romaneio em PDF (separe por vírgula para mais de um).
# Caixa (Almoxarifado) e Carregamento/Desembarque (Expedição/Em Campo) têm
# listas de destinatários separadas.
ROMANEIO_CAIXA_EMAIL_TO=leo.neves@burntech.com.br
ROMANEIO_CARREGAMENTO_EMAIL_TO=bruno.ribeiro@burntech.com.br,jackson.weber@burntech.com.br

# ── Impressão de etiquetas (Argox, uma por perfil) ──────────
# Nome exato da impressora tal como aparece no Windows do computador
# ligado às Argox por USB (o "computador-ponte") — não é um IP nem
# caminho de rede, é só o nome da fila de impressão local. O app só
# enfileira o pedido (POST /api/etiquetas); quem imprime de verdade é
# o agente local em print-agent/, rodando nesse computador.
IMPRESSORA_ALMOXARIFADO_NOME=Argox-Almoxarifado
IMPRESSORA_EXPEDICAO_NOME=Argox-expedicao

# Chave fixa que o agente de impressão local usa pra se autenticar
# nas rotas /api/etiquetas/* (não é um login de perfil — o agente não
# é uma pessoa, é o programinha do computador-ponte). Gere uma nova
# com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e use o mesmo valor no .env do print-agent/.
AGENT_API_KEY=TROQUE_POR_UMA_CHAVE_LONGA_E_ALEATORIA

# ── Banco do ERP (SQL Server) — catálogo de itens/materiais ────
# Somente leitura. A aplicação consulta a tabela PRO_PRODUTO em tempo
# real (código, descrição, peso líquido) — não escreve nada nesse
# banco. O cadastro dos itens é feito e mantido de fora, no ERP.
# Porta 1433 é a porta padrão de dados do SQL Server (a 1434/UDP é só
# o SQL Server Browser, usado pra descobrir instâncias nomeadas —
# não precisa dela pra conectar direto num host:porta conhecidos).
ERP_DB_HOST=SEU_HOST_SQLSERVER
ERP_DB_PORT=1433
ERP_DB_NAME=NOME_DO_BANCO
ERP_DB_USER=SEU_USUARIO
ERP_DB_PASSWORD=SUA_SENHA_AQUI
# true se o SQL Server exigir conexão criptografada
ERP_DB_ENCRYPT=false
