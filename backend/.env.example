# ── E-mail SMTP ──────────────────────────────────
# Usado para enviar o romaneio (PDF) ao finalizar uma caixa.
MAIL_SERVER=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=SEU_EMAIL@burntech.com.br
MAIL_PASSWORD=SUA_SENHA_AQUI
MAIL_DEFAULT_SENDER=SEU_EMAIL@burntech.com.br

# Destinatário(s) do romaneio em PDF (separe por vírgula para mais de um)
ROMANEIO_EMAIL_TO=jackson.weber@burntech.com.br

# ── Banco do ERP (SQL Server) — catálogo de itens/materiais ────
# Somente leitura. A aplicação consulta a tabela PRO_PRODUTO em tempo
# real (código, descrição, peso líquido) — não escreve nada nesse
# banco. O cadastro dos itens é feito e mantido de fora, no ERP.
# Porta 1433 é a porta padrão de dados do SQL Server (a 1434/UDP é só
# o SQL Server Browser, usado pra descobrir instâncias nomeadas —
# não precisa dela pra conectar direto num host:porta conhecidos).
ERP_DB_HOST=SEU_HOST_SQLSERVER
ERP_DB_PORT=1433
ERP_DB_NAME=NOME_DO_BANCO
ERP_DB_USER=SEU_USUARIO
ERP_DB_PASSWORD=SUA_SENHA_AQUI
# true se o SQL Server exigir conexão criptografada
ERP_DB_ENCRYPT=false
