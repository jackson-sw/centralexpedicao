# ── Banco de Dados ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=SUA_SENHA_AQUI
DB_NAME=burntech_expedicao

# ── Servidor ────────────────────────────────────
PORT=3002

# ── JWT ─────────────────────────────────────────
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
JWT_EXPIRES_IN=8h

# ── CORS (domínio do frontend em produção) ──────
CORS_ORIGIN=http://localhost:3002

# ── Perfil Expedição (senha padrão: exp!2027) ───────────────
