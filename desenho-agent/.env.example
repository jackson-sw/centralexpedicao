# URL do backend do Central Expedição (a mesma que o app usa, com https://)
API_URL=https://seu-dominio.com.br

# Precisa ser IDÊNTICA ao AGENT_API_KEY configurado no backend/.env do servidor
# (é a mesma chave usada pelo print-agent/ — qualquer agente local confiável
# usa essa chave pra se autenticar nas rotas de agente).
AGENT_API_KEY=TROQUE_POR_UMA_CHAVE_LONGA_E_ALEATORIA

# De quanto em quanto tempo (em milissegundos) o agente consulta a fila.
# 5000 = a cada 5 segundos. Não precisa ser muito rápido.
POLL_INTERVAL_MS=5000

# Caminho da pasta raiz dos projetos no servidor de arquivos, visto por
# ESTA máquina (pode ser um caminho local, tipo D:\..., ou um caminho de
# rede mapeado). Termine com uma barra invertida.
PASTA_PROJETOS=D:\Engenharia\0 - Engenharia do Produto\02 - Projetos\

# Nome exato da impressora, como aparece no Windows DESTA máquina — não
# precisa ser idêntico ao nome usado no computador do Almoxarifado
# (IMPRESSORA_ROMANEIO_NOME no backend/.env), mesmo sendo fisicamente a
# mesma impressora: cada computador pode enxergá-la com um nome
# diferente quando ela é compartilhada na rede.
IMPRESSORA_DESENHOS_NOME=
